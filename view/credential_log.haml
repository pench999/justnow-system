%h2 認証情報の操作履歴
%table
  %thead
    %tr
      - ['日時 (JST)', 'ユーザー', '表示名', '認証情報ID', '操作', '接続元', '結果'].each do |title|
        %th&= title
  %tbody
    - @credential_logs.each do |row|
      %tr
        %td&= Time.utc(row['occurred_at'].year, row['occurred_at'].month, row['occurred_at'].day, row['occurred_at'].hour, row['occurred_at'].min, row['occurred_at'].sec).getlocal('+09:00').strftime('%Y-%m-%d %H:%M:%S')
        - ['username', 'fullname', 'credential_id', 'action', 'sourceip', 'result'].each do |field|
          %td&= row[field]
