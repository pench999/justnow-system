%h2 認証情報の操作履歴
%table
  %thead
    %tr
      - ['日時', 'ユーザー', '表示名', '認証情報ID', '操作', '接続元', '結果'].each do |title|
        %th&= title
  %tbody
    - @credential_logs.each do |row|
      %tr
        - ['occurred_at', 'username', 'fullname', 'credential_id', 'action', 'sourceip', 'result'].each do |field|
          %td&= row[field]
